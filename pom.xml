<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.win</groupId>
    <artifactId>ddd</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ddd</name>
    <description>DDD 基础架构项目（多模块，依赖逐层递进）</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
      模块依赖递进关系（下层不感知上层，领域层不依赖任何 Spring 技术）：
        ddd-common           纯 Java，零第三方依赖
        ddd-domain         → ddd-common                领域层：实体/值对象/领域服务/仓储接口
        ddd-application    → ddd-domain                应用层：用例编排
        ddd-infrastructure → ddd-domain                基础设施层：JPA/安全等技术实现
        ddd-userinterface  → ddd-application           用户接口层：REST 控制器
        ddd-bootstrap      → application + infrastructure + userinterface
                           启动装配：启动类、配置文件、数据库驱动、打包插件
    -->
    <modules>
        <module>ddd-common</module>
        <module>ddd-domain</module>
        <module>ddd-application</module>
        <module>ddd-infrastructure</module>
        <module>ddd-userinterface</module>
        <module>ddd-bootstrap</module>
    </modules>
</project>
